{
  "name": "abler-mcp",
  "version": "0.3.0",
  "description": "Unofficial, read-only Abler schedules MCP server with portable session authentication",
  "type": "module",
  "bin": {
    "abler-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.19",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "tsc --noEmit",
    "test": "bun test",
    "start": "bun src/cli.ts",
    "prepack": "bun run check && bun test && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "proper-lockfile": "^4.1.2",
    "tough-cookie": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.2.19",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Ólafur Nils Sigurðsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olafurns7/abler-mcp.git"
  },
  "homepage": "https://github.com/olafurns7/abler-mcp#readme",
  "bugs": {
    "url": "https://github.com/olafurns7/abler-mcp/issues"
  },
  "keywords": [
    "abler",
    "mcp",
    "model-context-protocol",
    "schedule",
    "sports",
    "family"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
