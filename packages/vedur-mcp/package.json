{
  "name": "vedur-mcp",
  "version": "0.1.1",
  "description": "Read-only Icelandic weather MCP: IMO (Veðurstofa Íslands) forecasts, observations, official warnings, and forecaster commentary",
  "license": "MIT",
  "author": "Ólafur Nils Sigurðsson",
  "type": "module",
  "scripts": {
    "format": "oxfmt -c ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "build:binary": "node ../../tooling/release/build-binary.mjs --package .",
    "test:binary": "node ../../tooling/release/mcp-smoke.mjs --package . --bin release/native/vedur-mcp --standalone",
    "test:installer": "node ../../tooling/release/installer-test.mjs --package .",
    "release:sync": "node ../../tooling/release/sync-version.mjs --package .",
    "release:check": "node ../../tooling/release/render-install.mjs --package . --check && node ../../tooling/release/sync-version.mjs --package . --check"
  },
  "devDependencies": {
    "@family-mcp/release-tooling": "workspace:*"
  },
  "packageManager": "bun@1.4.2",
  "familyMcp": {
    "release": {
      "tools": [
        "search_stations",
        "get_forecast",
        "get_observations",
        "get_weather_alerts",
        "get_weather_watch"
      ],
      "rust": "vedur-mcp"
    }
  }
}
