{
  "name": "@family-mcp/mcp-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Small shared MCP runtime helpers for the family MCP servers",
  "author": "Ólafur Nils Sigurðsson",
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error .",
    "lint:fix": "bun run lint --fix",
    "format": "oxfmt -c ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@family-mcp/oxlint-anti-slop": "workspace:*",
    "@family-mcp/tsconfig": "workspace:*",
    "@types/bun": "^1.2.19"
  },
  "packageManager": "bun@1.4.2"
}
