{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "tooling/tsconfig/**",
    "tooling/oxlint-anti-slop/**",
    "tooling/release/**"
  ],
  "tasks": {
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "format:check": {
      "outputs": [],
      "dependsOn": ["//#format:root:check"]
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "format:check", "release:check"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["//#format:root"]
    },
    "//#format:root": {
      "cache": false,
      "outputs": []
    },
    "//#format:root:check": {
      "outputs": [],
      "inputs": [
        "package.json",
        "turbo.json",
        ".oxlintrc.json",
        ".oxfmtrc.json",
        ".github/**",
        "tooling/**"
      ]
    },
    "build:binary": {
      "cache": false,
      "outputs": ["release/**"]
    },
    "test:binary": {
      "dependsOn": ["build:binary"],
      "cache": false,
      "outputs": []
    },
    "test:installer": {
      "dependsOn": ["build:binary"],
      "cache": false,
      "outputs": []
    },
    "release:sync": {
      "cache": false,
      "outputs": []
    },
    "release:check": {
      "outputs": []
    },
    "@family-mcp/release-tooling#test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/workflows/release.yml"]
    }
  },
  "remoteCache": {
    "enabled": false
  },
  "cacheDir": ".turbo/cache"
}
