{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.test-build/**",
    "packages/*/release/**",
    "**/.turbo/**",
    "bun.lock",
    "**/*.tgz",
    "**/*.tgz.sha256",
    "tooling/oxlint-anti-slop/*",
    "!tooling/oxlint-anti-slop/package.json",
    "docs/analysis/**",
    "packages/kronan-mcp/api/openapi.json",
    "packages/kronan-mcp/api/kronan-api.d.ts"
  ],
  "overrides": [
    {
      "files": ["packages/abler-mcp/**", "packages/kronan-mcp/**"],
      "options": {
        "sortImports": {}
      }
    }
  ]
}
